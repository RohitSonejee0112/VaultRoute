# ==============================================================================
# Enterprise Operational Reporting & Document Distribution System (ORDDS)
# Environment Configuration Template
# ==============================================================================

# Application & Environment
NODE_ENV=production
LOG_LEVEL=info
APP_PORT=3000

# Cryptography & HMAC Security Keys
# Pre-shared secrets for partner authenticity & non-repudiation
HMAC_SECRET_KEY_WEALTH_MGMT=secret_wm_core_k98234j234klj234
HMAC_SECRET_KEY_LEGAL_COMPLIANCE=secret_compliance_m90234i09234km2
HMAC_SECRET_KEY_CLIENT_PORTAL=secret_client_portal_a897234mn234
HMAC_SECRET_KEY_UNDERWRITING=secret_underwriting_p876234bmn23

# Simulation & Deterministic Chaos Parameters
DEFAULT_SIMULATION_PROFILE=nominal-load
DEFAULT_CHAOS_SEED=42
SIMULATION_BATCH_COUNT=60

# Distributed Resilience & Circuit Breaker Thresholds
CIRCUIT_BREAKER_FAILURE_THRESHOLD_PCT=50
CIRCUIT_BREAKER_WINDOW_MS=10000
CIRCUIT_BREAKER_COOLDOWN_MS=4000
JITTER_BACKOFF_BASE_MS=80
JITTER_BACKOFF_CAP_MS=1500
PREDICTIVE_SLA_BURN_ALERT_PCT=75

# Reporting & Storage
REPORTS_OUTPUT_DIR=./data/reports
STREAM_EXCEL_GENERATION=true

# Optional Redis / Message Broker (for distributed multi-worker deployment)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
